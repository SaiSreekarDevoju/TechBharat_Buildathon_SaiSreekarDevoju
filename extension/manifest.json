{
  "manifest_version": 3,
  "name": "Lumen \u2014 On-screen Intelligence",
  "version": "1.0.0",
  "description": "Summarizes what you are viewing on screen into a structured, actionable brief without leaving the current tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "sidePanel",
    "tabs"
  ],
  "action": {
    "default_title": "Lumen \u2014 Understand what's on your screen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-lumen": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Lumen Side Panel"
    }
  },
  "minimum_chrome_version": "142"
}
